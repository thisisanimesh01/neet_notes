# =============================================================================
# NEET Notes 2027 — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit your .env file or paste real secrets into this file.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# PostgreSQL connection string (Supabase: use the "Transaction" pooler URL for app)
DATABASE_URL=

# PostgreSQL direct connection (Supabase: use the "Session" or direct connection URL)
# Required for Prisma migrations. Leave empty if not using a connection pooler.
DIRECT_URL=

# -----------------------------------------------------------------------------
# ADMIN CREDENTIALS (server-side only — never exposed to browser)
# -----------------------------------------------------------------------------
# Admin username for the /admin panel
ADMIN_USERNAME=

# Bcrypt hash of the admin password (REQUIRED in production — plaintext ADMIN_PASSWORD is NOT needed)
# Generate with: node -e "require('bcryptjs').hash('YOUR_PASSWORD', 10).then(console.log)"
ADMIN_PASSWORD_HASH=

# Optional: Admin plain-text password (only used as fallback in local development, ignored in production)
# ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# RAZORPAY (server-side secrets — NEVER use NEXT_PUBLIC_ prefix for secrets)
# -----------------------------------------------------------------------------
# Key ID from Razorpay Dashboard (starts with rzp_live_ in production)
RAZORPAY_KEY_ID=

# Key Secret from Razorpay Dashboard (server-only — never expose to browser)
RAZORPAY_KEY_SECRET=

# Same as RAZORPAY_KEY_ID — safe for browser (only identifies merchant account)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Webhook secret from Razorpay Dashboard → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# PDF STORAGE
# -----------------------------------------------------------------------------
# Storage provider: "local" (development) or "supabase" (production)
STORAGE_PROVIDER=local

# Supabase project URL (e.g. https://abcdefghij.supabase.co)
SUPABASE_URL=

# Supabase service role key (server-only — NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Name of the private Supabase storage bucket
SUPABASE_STORAGE_BUCKET=neet-notes-private

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
# Public URL of the deployed application (no trailing slash)
APP_URL=http://localhost:3000

NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
