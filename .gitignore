# ==============================================================================
# ENVIRONMENT & SECRETS
# ==============================================================================
# Ignore all environment variable files containing private credentials/keys
.env
.env.*
.env*.local
.env.local
.env.development
.env.development.local
.env.development-backup
.env.test
.env.test.local
.env.production
.env.production.local
.env.save

# Explicitly allow the safe template file to be tracked in version control
!.env.example

# ==============================================================================
# CREDENTIALS, TOKENS & PRIVATE KEYS
# ==============================================================================
credentials/
secrets/
secret/
credentials.json
service-account*.json
serviceAccount*.json
*.pem
*.key
*.crt
*.p12
*.pfx

# ==============================================================================
# PRIVATE STORAGE & USER-UPLOADED CONTENT
# ==============================================================================
# Protect all private digital notes, preview assets, and uploaded PDFs
storage/
storage/private/
storage/previews/
uploads/
private/
private-storage/
pdfs/
*.pdf

# ==============================================================================
# DATABASE & LOCAL STORAGE
# ==============================================================================
dev.db
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
prisma/dev.db*
prisma/*.db*

# ==============================================================================
# NEXT.JS & BUILD ARTIFACTS
# ==============================================================================
.next/
/out/
/dist/
/build/
.turbo/
*.tsbuildinfo
next-env.d.ts

# ==============================================================================
# DEPENDENCIES & PACKAGE MANAGERS
# ==============================================================================
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ==============================================================================
# TESTING & COVERAGE
# ==============================================================================
/coverage/
coverage/
*.lcov
.nyc_output/

# ==============================================================================
# VERCEL & DEPLOYMENT TOOLING
# ==============================================================================
.vercel/
.vercel

# ==============================================================================
# LOGS
# ==============================================================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ==============================================================================
# OS & EDITOR FILES
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# IDEs & Editors
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.windsurf/

# Temporary / Backup files
*.tmp
*.temp
*.bak
*.backup
*~
*.swp
*.swo
